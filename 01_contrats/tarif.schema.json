{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tarif",
  "description": "La grille de prix de Calorelle, que le service facturation de la PME lit pour chiffrer un devis (étape 5, tranche 5). Prix hors taxes, fictifs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["annee", "lignes"],
  "properties": {
    "annee": {
      "type": "integer",
      "minimum": 2020,
      "description": "Année du tarif."
    },
    "lignes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "libelle", "unite", "prix_ht_euros"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}-[0-9]{2,3}$",
            "description": "Par exemple CHA-01."
          },
          "libelle": {
            "type": "string",
            "minLength": 1
          },
          "unite": {
            "type": "string",
            "enum": ["unité", "heure", "forfait", "mètre"]
          },
          "prix_ht_euros": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Prix hors taxes d'une unité, au centime."
          }
        }
      }
    }
  }
}
