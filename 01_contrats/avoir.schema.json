{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Avoir",
  "description": "Un avoir émis sur une facture client par le service facturation de la PME : un remboursement ou un geste commercial. Données fictives.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "numero",
    "client",
    "facture",
    "date",
    "montant_ttc_euros",
    "motif",
    "emis_par"
  ],
  "properties": {
    "numero": {
      "type": "string",
      "pattern": "^AV-[0-9]{4}-[0-9]{4}$",
      "description": "Par exemple AV-2026-0001."
    },
    "client": {
      "type": "string",
      "pattern": "^c-[0-9]{4}$"
    },
    "facture": {
      "type": "string",
      "pattern": "^FC-[0-9]{4}-[0-9]{4}$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Heure simulée de la PME, au format RFC 3339 avec le décalage horaire."
    },
    "montant_ttc_euros": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "motif": {
      "type": "string",
      "minLength": 1
    },
    "emis_par": {
      "type": "string",
      "minLength": 1,
      "description": "Identifiant de la personne servie, dans l'organigramme."
    }
  }
}
