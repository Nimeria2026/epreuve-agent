# Les variables que lit l'atelier, sans leur valeur. Copier ce fichier en .env, hors git, et le
# remplir. Une IA ne lit jamais .env : elle vérifie seulement qu'une variable y est.

# DeepSeek, API officielle : les candidats deepseek_flash et le juge du banc.
DEEPSEEK_API_KEY=

# DeepInfra : MiMo-V2.6-Flash, DeepSeek et gpt-oss chez DeepInfra.
DEEPINFRA_API_KEY=

# OpenRouter : l'utilisateur simulé de τ²-bench, et MiniMax.
OPENROUTER_API_KEY=

# GMI Cloud : Qwen 3.8 Max. Les tâches cachées n'y vont jamais.
GMICLOUD_API_KEY=

# Strata : la clé du serveur local de Flash-Next (make strata).
STRATA_API_KEY=
